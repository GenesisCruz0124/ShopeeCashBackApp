{
  "name": "shopee-cashback-app",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace packages/shared",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace packages/shared && npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend"
  }
}
